---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { url } from '../../site';
import { pad2 } from '../../plates';
const docs = (await getCollection('brain', ({ data }) => data.public)).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Principles" description="The vision, principles and topic map behind the catalog." current="principles">
  <div class="wrap">
    <div class="g" style="padding-top:48px;row-gap:24px;align-items:end">
      <div class="s3 label">The catalog's brain<br />{docs.length} documents</div>
      <h1 class="s9 giant">Principles</h1>
    </div>
    <div class="g hair-top" style="margin-top:32px;row-gap:16px;align-items:baseline">
      <p class="s3 label" style="margin:0">In the open</p>
      <p class="s7 deck" style="font-size:24px">What this catalog is for, what it believes, and how it is organized. These documents live in the repository next to every edition, and change in the open.</p>
    </div>
    <ul class="rows" style="margin-top:48px">
      {docs.map((d, i) => (
        <li><a class="g" href={url(`/brain/${d.id}/`)}>
          <span class="s2 n">{pad2(i + 1)}</span>
          <span class="s6"><span class="t">{d.data.title}</span></span>
          <span class="s4 d">{d.data.summary}</span>
        </a></li>
      ))}
    </ul>
  </div>
</Base>
