---
import '../styles/global.css';
import { SITE_TITLE, SITE_TAGLINE, REPO_URL, SUBSCRIBE_URL, url, pad } from '../site';
import { getEditions } from '../editions';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  current?: 'catalog' | 'editions' | 'plates' | 'principles';
}
const { title, description = SITE_TAGLINE, image, current } = Astro.props;
const fullTitle = title ? `${title} — ${SITE_TITLE}` : SITE_TITLE;
const ogImage = image ? new URL(url(image), Astro.site).href : undefined;
const latest = (await getEditions())[0];
const month = latest?.data.date.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const cur = (k: string) => (current === k ? 'page' : undefined);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={url('/rss.xml')} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;700;800;900&family=IBM+Plex+Mono:wght@400;500&display=swap" />
  </head>
  <body>
    <header class="wrap">
      <div class="bar g label">
        <div class="s3" style="font-weight:500"><a href={url('/')}>Natural Intelligence</a></div>
        <div class="s3">{latest && <a href={url(`/editions/${latest.id}/`)}>Edition {pad(latest.data.number)} — {month}</a>}</div>
        <nav aria-label="Main" class="s4">
          <a href={url('/')} aria-current={cur('catalog')}>Catalog</a>
          <a href={url('/editions/')} aria-current={cur('editions')}>Editions</a>
          <a href={url('/plates/')} aria-current={cur('plates')}>Plates</a>
          <a href={url('/brain/')} aria-current={cur('principles')}>Principles</a>
          <a href={url('/#subscribe')}>Subscribe</a>
        </nav>
        <div class="s2 right">Free</div>
      </div>
      <slot name="masthead" />
    </header>
    <main>
      <slot />
    </main>
    <section id="subscribe" class="band" aria-labelledby="sub-h">
      <slot name="band">
        <div class="wrap">
          <div class="g" style="row-gap:32px;align-items:end">
            <h2 id="sub-h" class="s7">Get the next issue.</h2>
            <div class="s5" style="border-top:2px solid var(--paper);padding-top:16px">
              {SUBSCRIBE_URL
                ? <a class="btn" href={SUBSCRIBE_URL}>Subscribe, free →</a>
                : <a class="btn" href={url('/rss.xml')}>Follow by RSS →</a>}
              <p class="note m">{SUBSCRIBE_URL ? 'One email per issue. No tracking pixels. Leave with one click.' : 'Email subscriptions open soon. One email per issue, no tracking pixels.'}</p>
            </div>
          </div>
        </div>
      </slot>
    </section>
    <footer class="site wrap" style="padding-top:24px;padding-bottom:40px">
      <div class="g m">
        <div class="s4"><span class="label" style="font-weight:500">Natural Intelligence</span><br />{SITE_TAGLINE}</div>
        <div class="s5">Set in Schibsted Grotesk and IBM Plex Mono. Every plate is generated by a short program. Text CC BY 4.0, code MIT, <a href={REPO_URL}>source on GitHub</a>.</div>
        <nav aria-label="Footer" class="s3">
          <a href={url('/editions/')}>Editions</a>
          <a href={url('/plates/')}>Plates</a>
          <a href={url('/brain/')}>Principles</a>
          <a href={url('/rss.xml')}>RSS</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
