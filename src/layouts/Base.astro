---
import '../styles/global.css';
import { SITE_TITLE, SITE_TAGLINE, REPO_URL, url } from '../site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}
const { title, description = SITE_TAGLINE, image } = Astro.props;
const fullTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE;
const ogImage = image ? new URL(url(image), Astro.site).href : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={url('/rss.xml')} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
  </head>
  <body>
    <header class="masthead">
      <div class="wrap">
        <a class="wordmark" href={url('/')}>Natural Intelligence <span>Catalog</span></a>
        <nav class="nav">
          <a href={url('/editions/')}>Editions</a>
          <a href={url('/brain/')}>Principles</a>
          <a href={url('/rss.xml')}>RSS</a>
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site">
      <div class="wrap">
        <p>{SITE_TITLE}. {SITE_TAGLINE}</p>
        <p>Text CC BY 4.0 unless noted. Code MIT. <a href={REPO_URL}>Source on GitHub</a>.</p>
      </div>
    </footer>
  </body>
</html>
